{
  "expo": {
    "name": "Stamp Addict",
    "slug": "stamp-addict",
    "scheme": "stampaddict",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stamp Addict uses your photos so you can add pictures of your stamps.",
          "cameraPermission": "Stamp Addict uses the camera to photograph your stamps."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    }
  }
}
