{
  "name": "stamp-addict",
  "version": "0.1.0",
  "private": true,
  "description": "Stamp Addict: a mobile app for cataloging a stamp collection, one Stamp Card per stamp.",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npx expo install --fix",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:core": "npx --yes tsx --test src/core/test/*.test.ts",
    "schema": "node scripts/embed-schema.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.23",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-sharing": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
