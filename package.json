{
  "name": "stamp-addict",
  "version": "0.1.0",
  "private": true,
  "description": "Stamp Addict: a mobile app for cataloging a stamp collection, one Stamp Card per stamp.",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npx expo install --fix",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:core": "npx --yes tsx --test src/core/test/*.test.ts",
    "schema": "node scripts/embed-schema.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "jszip": "^3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
